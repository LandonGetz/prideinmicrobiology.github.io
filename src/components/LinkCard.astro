---
interface Props {
  title: string;
  description: string;
  link: string;
}

const { title, description, link } = Astro.props;
const displayUrl = link.replace(/^https?:\/\//, '').slice(0, 50);
---

<div class="link-card">
  <a href={link} target="_blank" rel="noopener noreferrer">
    <div class="link-card-body">
      <h4 class="link-card-title">{title}</h4>
      <p class="link-card-description">{description}</p>
      <div class="link-card-url">
        <i class="fa fa-external-link"></i>
        {displayUrl}
      </div>
    </div>
  </a>
</div>
