---
---

<div id="search-container" class="relative w-full max-w-md mx-auto mb-8">
  <div class="relative">
    <input
      type="text"
      id="search-input"
      placeholder="Search posts and profiles..."
      class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600
             bg-white dark:bg-gray-800 text-black dark:text-white
             focus:ring-2 focus:ring-secondary focus:border-transparent transition-colors
             placeholder:text-gray-400"
    />
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>
  <div id="search-results" class="absolute top-full left-0 right-0 mt-1 bg-white dark:bg-gray-800
       rounded-lg shadow-lg border border-gray-200 dark:border-gray-700 hidden z-50 max-h-80 overflow-y-auto">
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  interface SearchItem {
    type: 'post' | 'profile';
    title: string;
    author?: string;
    position?: string;
    categories?: string[];
    identity?: string;
    slug: string;
    excerpt: string;
  }

  let fuse: Fuse<SearchItem>;

  async function initSearch() {
    const response = await fetch('/search-index.json');
    const data: SearchItem[] = await response.json();

    fuse = new Fuse(data, {
      keys: ['title', 'author', 'categories', 'position', 'identity', 'excerpt'],
      threshold: 0.3,
      includeMatches: true,
    });
  }

  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;

  input?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value;
    if (query.length < 2) {
      results.classList.add('hidden');
      return;
    }

    if (!fuse) return;

    const matches = fuse.search(query).slice(0, 8);
    if (matches.length === 0) {
      results.innerHTML = '<div class="p-4 text-gray-500 dark:text-gray-400">No results found</div>';
    } else {
      results.innerHTML = matches.map(({ item }) => `
        <a href="${item.slug}" class="block p-3 hover:bg-gray-50 dark:hover:bg-gray-700 border-b border-gray-100 dark:border-gray-700 last:border-0 transition-colors">
          <span class="text-xs uppercase text-secondary font-heading font-semibold">${item.type}</span>
          <div class="font-heading font-bold text-black dark:text-white">${item.title}</div>
          ${item.author ? `<div class="text-sm text-gray-500 dark:text-gray-400">${item.author}</div>` : ''}
          ${item.position ? `<div class="text-sm text-gray-500 dark:text-gray-400">${item.position}</div>` : ''}
        </a>
      `).join('');
    }
    results.classList.remove('hidden');
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!document.getElementById('search-container')?.contains(e.target as Node)) {
      results.classList.add('hidden');
    }
  });

  initSearch();
</script>
