---
import { siteConfig } from '@lib/config';
---

<section id="contact" class="py-20 gradient-subtle">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <!-- Contact Form -->
      <div data-animate class="glass rounded-2xl p-8 shadow-lg">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-center text-gray-900 dark:text-white mb-2">Join the Network</h2>
        <hr class="w-16 mx-auto border-t-2 border-secondary mb-8" />
        <form action={siteConfig.formspree} method="POST" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-heading font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Name</label>
            <input
              type="text"
              name="name"
              id="name"
              required
              placeholder="Your name"
              class="w-full px-4 py-3.5 rounded-xl border border-gray-200 dark:border-gray-600
                     bg-white/80 dark:bg-gray-800/80 text-black dark:text-white
                     focus:ring-2 focus:ring-secondary focus:border-transparent focus:shadow-md
                     transition-all duration-300 placeholder:text-gray-400"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-heading font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Email Address</label>
            <input
              type="email"
              name="_replyto"
              id="email"
              required
              placeholder="your@email.com"
              class="w-full px-4 py-3.5 rounded-xl border border-gray-200 dark:border-gray-600
                     bg-white/80 dark:bg-gray-800/80 text-black dark:text-white
                     focus:ring-2 focus:ring-secondary focus:border-transparent focus:shadow-md
                     transition-all duration-300 placeholder:text-gray-400"
            />
          </div>
          <input type="hidden" name="_subject" value="New submission!" />
          <div style="display:none">
            <input type="text" name="_gotcha" />
          </div>
          <div>
            <label for="message" class="block text-sm font-heading font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Message</label>
            <textarea
              name="message"
              id="message"
              rows="4"
              required
              placeholder="Your message..."
              class="w-full px-4 py-3.5 rounded-xl border border-gray-200 dark:border-gray-600
                     bg-white/80 dark:bg-gray-800/80 text-black dark:text-white
                     focus:ring-2 focus:ring-secondary focus:border-transparent focus:shadow-md
                     transition-all duration-300 resize-y placeholder:text-gray-400"
            ></textarea>
          </div>
          <div class="text-center pt-2">
            <button type="submit" class="btn-primary text-base">Send</button>
          </div>
        </form>
      </div>

      <!-- Discord -->
      <div data-animate data-delay="150" class="glass rounded-2xl p-8 shadow-lg flex flex-col items-center justify-center text-center">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900 dark:text-white mb-2">Join our Discord</h2>
        <hr class="w-16 mx-auto border-t-2 border-secondary mb-6" />
        <p class="text-gray-600 dark:text-gray-300 mb-8 max-w-sm">
          Connect with 2SLGBTQIA+ microbiologists from around the globe in real-time conversations.
        </p>
        <a href={siteConfig.discord} target="_blank" rel="noopener noreferrer" class="btn-primary text-base">
          <i class="fab fa-discord mr-2"></i> Join the Discord!
        </a>
      </div>
    </div>
  </div>
</section>
