---
import BaseLayout from './BaseLayout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';

interface Props {
  frontmatter: {
    title: string;
    img: string;
    alt?: string;
    'degree-held': string;
    position: string;
    pronouns: string;
    identity: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title}>
  <Nav variant="profile" />

  <header class="bg-white dark:bg-gray-900 pt-28 pb-8">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-secondary text-center mb-8">
        {frontmatter.title}
      </h1>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 items-start">
        <img
          src={`/img/portfolio/${frontmatter.img}`}
          alt={frontmatter.alt || frontmatter.title}
          class="w-full rounded-lg shadow-md"
        />
        <div class="space-y-3">
          <div>
            <span class="font-heading font-bold text-secondary">Degree Held: </span>
            <span class="text-black dark:text-gray-200">{frontmatter['degree-held']}</span>
          </div>
          <div>
            <span class="font-heading font-bold text-secondary">Current Position: </span>
            <span class="text-black dark:text-gray-200">{frontmatter.position}</span>
          </div>
          <div>
            <span class="font-heading font-bold text-secondary">Pronouns: </span>
            <span class="text-black dark:text-gray-200">{frontmatter.pronouns}</span>
          </div>
          <div>
            <span class="font-heading font-bold text-secondary">Identity: </span>
            <span class="text-black dark:text-gray-200">{frontmatter.identity}</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="bg-white dark:bg-gray-900 pb-16 flex-1">
    <div class="max-w-4xl mx-auto px-4">
      <article class="prose prose-lg dark:prose-invert max-w-none mt-8
                       prose-headings:font-heading prose-headings:text-secondary
                       prose-a:text-secondary-light prose-a:font-bold">
        <slot />
      </article>
    </div>
  </main>

  <Footer />
</BaseLayout>
